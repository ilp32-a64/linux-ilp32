# SPDX-License-Identifier: GPL-2.0

syscall_abis_32 +=
syscall_abis_64 += renameat rlimit memfd_secret
# ILP32: the generic table with the 32-bit ABI variants and time32 calls, compat entry points
syscall_abis_ilp32 += common 32 time32 stat64 memfd_secret

syscalltbl = arch/arm64/tools/syscall_%.tbl

# ILP32 reads the generic table directly. Static pattern rules take precedence over the
# pattern rules of scripts/Makefile.asm-headers and keep the stem ($*) ilp32.
$(obj)/unistd_ilp32.h: $(obj)/unistd_%.h: $(srctree)/scripts/syscall.tbl \
					  $(srctree)/scripts/syscallhdr.sh FORCE
	$(call if_changed,syshdr)

$(obj)/syscall_table_ilp32.h: $(obj)/syscall_table_%.h: $(srctree)/scripts/syscall.tbl \
						$(srctree)/scripts/syscalltbl.sh FORCE
	$(call if_changed,systbl)
